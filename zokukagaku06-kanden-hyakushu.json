 "poems": [
  {
   "seq": "1",
   "text": "十といひて六田のよとの古柳くちなで又も春にあひおけり",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "心あそなほ若がへれ六十ぢあまりみつの始の春をむかへて",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "あらたまの年の始にとるふでの命毛ながきもさびとぞみる",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "-いと早もこぞの氷のながれ洲に春をみさごの聲のどかなり",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "春のきてあふぐ山邊にたちそむる霞や花の玄をりなるらむ",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "みかくるも遠き山べの夕がすみやがてまぎるゝ春の雁がね",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "草まくら妹こひしらに片しきの袖にはかなくかよふ梅が香",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "由子の浦をいづる卅人いかにみむ春ハ明ぼの山いふじのね",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "いつしかと花まつあろの山寺におもかどにほふ軒の玄ら雲",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "世はなれて長閑にすめる山水に此ごろもヽの花もうかべり",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "初午のけふにあひてぞ稻荷山はなおき杉もひとに折らるゝ",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "船とめてなにはもわかず霞む江に梅さきぬらしにほふ浦風",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "みさをなき物とやいはむ吹わたる風を姿になびくやなぎい",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "さま〓〓の花いあれども日本のはるのひかりぞ櫻なりける",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "吹おろも嵐の山の花を比せておのがものとや下もいかだし",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "〓春いまた橋の名によぶ月のみか花せきわたす夜はの河よど",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "君ゆかい花ふ法かたれ吉野山われもみしよの春を玄のぶと",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "まださかぬ木末もよしや吉野山われおおくれてあむ人の爲",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "いり方に近づく後も山鳥のおろのはつをのながき日のかげ",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "思ひかねながむる空にゆく雲も春をおくると見えて寂しき",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "殿の內比よそひもかふる今日といへバ宮つこさへに夏衣せむ",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "わグ門のわさ田うゝべき日を近み垣ほの卯木花さきおけり",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "夏木立玄げりあひてい山本につらなる里もみらくもくなき",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "ひと聲にやがてさめけり時鳥まつにたゆまぬ手まくらの夢",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "よひの雨につれなかりしい有明の月やまちけむやま霍公鳥",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "ふき通ふ風もかぐはし今日といへバ軒端の菖蒲もやの藥玉",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "〓末末の千尋をたのむ竹の子い生ひいづるよりいさましき哉",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "ゆふもヾみ石いふむとも石川や鴨のかはづら遊びてゆかむ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "入方の日かげもこめて愛宕山さつ玄らくものながめ涼しき",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "秋きぬと思ひもあへぞ吹風のなどうちつけに悲しかるらむ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "くるゝよに〓さ田の穗並猶みえて葉のぼる露にうつる稻妻",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "七草のかもならぬ草もけふにあふ盛にほしい手向とを見よ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "人ごとやいかにさが野の女郞花きり比籬にみえがくとする",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "思ふぞよ人の心もかるかやのあだなる風にみだれやもきに",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "葉を玄げみ日影へだつる朝顏い露のひるまもさき殘りけり",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "さを鹿いなぞや來なかぬ花妻と名ふたつ萩い今さかりなり",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "今こむといひし契やあり明の月にきはひてわたるかりがね",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "大空にあひもおもはぬ月をのみ友とたのみて秋もへにけり",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "-浮霧いあとなくはれて更る夜の月かげ煙るみづのをちこち",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "海原やかげも千さとにみつ汐の月をよせくる波のさやけさ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "さを鹿も何汝かひよと夢をだに結ばぬ草のまくらとふらむ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "雨になる空といみえぬ雲の色も秋い夕べのそでぬらしけり",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "けにぞ此あきい夕ぐれゆふ暮の秋のあはれを玄る君ぞきみ",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "わもとめや瀧つ流にまくらして紅葉のにしきかづく旅ねい",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "〓富士のねの雲をあふぎてゆく人も秋風寒しむさしのゝはら",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "よびつぎの濱風遠くさそふらし里もよさむのころもうつ聲",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "幾秋をふるき吉野比宮ところ霧のとばりにかけて玄ぬびつ",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "冬くれパめづらしゅなき時雨あもよひ〓〓さむる手枕の夢",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "白鷺のみの毛みだるヽ浦風にかれたつ蘆のおとむせぶなり",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "葎はふ軒端ともなしふきわたる風にあられの玉をかけてい",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "雪もまた八重山遠くふりつみてすゝまぬ駒のあしぶらの關",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "さにだのみ重げに見しも降そひて雪の山なす軒のくれたけ",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "何となく灰がきならし埋火のもと玄のぶこそ打もねられね",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "うき沈むおのがさま〓〓水鳥の流れて年のミなとふぞよる",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "荒いその藻に埋もるゝかたせ貝あはぬ思に世をやつくさむ",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "いかならむ人を靜めて後おとい賴めし夜半もあまり更ぬる",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "あふ事い遠山あづらうちはへて絕ぬばかりの中もはかなし",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "夢りさい今朝の別をうつゝぞと思ひ定めむふみもまちミぞ",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "ゝまもらをの山をぬくてふ力おもたへぬや戀の重荷なるらむ",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "忘草つむも比ならバあふ事のりさミをうしと歎りざらまし",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "あざ波い袖にさわぎてうき舟の思ふかたほにふく風もなし",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "-夢のまもいかで胡蝶にみをなして思ふあたりの花に馴なむ",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "ほとりなき靑海原と見る空に八十島なしてたてる玄らくも",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "うき物と見しよもありし曉を寐さむる時といまいなれぬる",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "ほど〓〓の節なかりせが呉竹の直きも賴むかひやなからむ",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "いそのあと古き道おい尋ねよる人やなからむ苔むしにけり",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "いにしへの人の心の高ま山いましもよそに見てすぎめやい",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "さしてゆく心の道しなほからバ何か人目もはゞかりのせき",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "あふみの海八十の湊も目に近くうつも鏡のやまの端ぞあれ",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "とことはに波の花さくさくら谷あの山人いはるもをしまじ",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "笠取とうべもいひけりうき世おい隱れてすめるおくの山里",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "ゆだねまく春の山田の浦舟のまをにまちとる風ものどけし",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "秋ぎりの山も幾重かこえぬらむつゆに嵐にそでをまかせて",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "いつしかと歸りこむ日をまつ人も心づくしの旅おやいあらぬ",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "花鳥いさもこそあらめ休らはでゆけや待らむかぞいろの爲",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "軒のまつ木だかくなりぬ山柴の玄ばしがほどと玄めし庵も",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "爪木とりあかくむ業も厭ふなよころものたまの光みるまで",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "天つ日の光をうつも衣手にあまねくも世のひとをおほはむ",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "ふぢかづら長きねざしも紫のはつもとゆひに契りかけおむ",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "かきかぞふ齡も千世を八重櫻ふりせぬ春のともとなれなむ",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "初わかな今年も春比あととめてつめや行方も千代のふる道",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "老が世にあそぶいかたき山水のとほき境もうつしゑお見よ",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "天の原ふりさけみつゝ幕ふらし馴れし南のほしのやどりを",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "かひありと賴むもはかな蝸牛これいおもひの家ならぬかい",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "かぐはしと思ふ惑にみをすつるためしい人もよそに見ましや",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "花よりもかぐはしきかな武夫のきみにすゝめし心ことのは",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "打なびく風のやなぎの手弱女も下におどろの",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993384",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "これもまた天つ少女の花かづらうつろはむ世〓哀とぞ見る",
   "kana": "",
   "speaker": "",
